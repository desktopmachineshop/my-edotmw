; Engine configuration file.
; See D-001 in game_design_decisions.md — Godot version is pinned in
; .godot-version and must match what the container/native tooling fetch.

config_version=5

[application]

config/name="my-edotmw"
config/features=PackedStringArray("4.7")
run/main_scene=""

[display]

; Off, so a `Window` node (the sandbox dev-tools panel) opens as a real,
; separate native OS window instead of an embedded sub-viewport drawn on
; top of the main game window — Godot's own default is embedded, which is
; exactly the "still inside the main window" behaviour this was added to
; fix.
window/subwindows/embed_subwindows=false

; Godot's own default (1152x648) is already SMALLER than HudLayout's
; 1280x720 reference size, so a fresh launch started at the HUD's scale
; floor before a player ever touched the window — reported as the UI
; being hard to read. This is a floor, not a lock: still ordinarily
; resizable, and `Client._ready` additionally enforces
; `HudLayout.min_window_size()` as the smallest it can be resized DOWN to.
window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

common/physics_ticks_per_second=10
; 10 Hz simulation tick is DECIDED — see D-020 in game_design_decisions.md.
; Per-LOD-tier variation remains open (deferred to M5 with D-012).
;
; Open implementation choice for M1: whether the authoritative sim is
; actually driven by _physics_process. D-009 keeps sim state in packed
; arrays outside the scene tree, so it need not be — this setting matching
; the sim rate is convenient, not required. Decide deliberately when the
; server loop is written; don't let the coupling happen by accident.
