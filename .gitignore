# Portable toolchain (Godot, just) — fetched by bootstrap, never committed
tools/

# Godot import cache
.godot/
.godot-container/

# Exported builds (#178). Produced by `just export` from committed
# presets, never committed themselves — a build is derivable from the
# source it was made from, and a 200 MB binary in git is the opposite of
# D-081's "commit the generator".
build/

# Test/load-test output, replays, terrain previews
artifacts/

# Godot editor mono/build cruft
.mono/
mono_crash.*.json

# Python bytecode from the asset generators (D-064)
__pycache__/
*.pyc

# OS cruft
Thumbs.db
.DS_Store

# Blender's rolling save backups. It writes <name>.blend1 (and .blend2 with a
# higher "Save Versions" preference) beside every file it saves, so these
# appear the first time anybody presses Ctrl-S in art/source/ and would
# otherwise be swept into the next commit — doubling the binary weight of the
# roster with copies of the PREVIOUS state of each model.
*.blend1
*.blend2
